{
  "permissions": {
    "allow": [
      "PowerShell(Get-Content *)",
      "PowerShell(Select-String *)",
      "PowerShell(npm run typecheck)",
      "Bash(npm run typecheck)",
      "PowerShell(npm -v)",
      "PowerShell(Get-ChildItem)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Select-Object *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && { npm run typecheck && npm run check; } >&2 || exit 2",
            "timeout": 120,
            "statusMessage": "Running typecheck and Biome..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push*)",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-force-push.cjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "PowerShell(git push*)",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-force-push.cjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
